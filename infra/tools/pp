#!/bin/bash
# pp — print, and record what it cost.
#
# CUPS cannot account for this printer: the Brother filter never reports page counts, so
# every job in the journal says "total 0". The page count has to come from the document,
# before it is sent, which is what this does — and then it writes a ledger line.
#
#   pp FILE...                 count pages, print, record
#   pp --dry-run FILE...       count only, print nothing (use this when testing the counter)
#   pp --pages 3 FILE          override the count
#   pp --kind photo FILE       ink class: mono | colour | photo  (default: colour)
#   pp -n 2 FILE               copies (recorded as pages × copies)
#   any other lp option is passed through, e.g. -o PageSize=BrA4_B
set -euo pipefail
PRINTER=${PRINTER:-DCPT230}
LEDGER=${LEDGER:-/var/lib/printcost/ledger.csv}
pages=""; kind="colour"; copies=1; lp_args=(); files=(); dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --pages) pages="$2"; shift 2 ;;
    --kind)  kind="$2"; shift 2 ;;
    --dry-run) dry=1; shift ;;
    -n)      copies="$2"; lp_args+=("-n" "$2"); shift 2 ;;
    -o|-d|-t|-h|-P) lp_args+=("$1" "$2"); shift 2 ;;
    -*)      lp_args+=("$1"); shift ;;
    *)       files+=("$1"); shift ;;
  esac
done

count_pages() {
  local f="$1" n=""
  case "${f,,}" in
    *.pdf)
      n=$(gs -q -dNODISPLAY -dNOSAFER -c "($f) (r) file runpdfbegin pdfpagecount = quit" 2>/dev/null || true)
      [ -z "$n" ] && n=$(pdfinfo "$f" 2>/dev/null | awk '/^Pages:/{print $2}')
      ;;
    *.ps|*.eps)
      # %%Pages is authoritative when present; otherwise count showpage anywhere on a line
      n=$(awk '/^%%Pages:/{print $2; exit}' "$f" 2>/dev/null)
      if [ -z "$n" ] || [ "$n" = "0" ]; then
        n=$(grep -c 'showpage' "$f" 2>/dev/null || echo 0)
      fi
      ;;
    *.jpg|*.jpeg|*.png|*.gif|*.webp|*.tif|*.tiff) n=1 ;;
    *.txt|*.csv|*.md|*.log)
      local bytes lines
      bytes=$(wc -c <"$f"); lines=$(wc -l <"$f")
      n=$(( (bytes / 3000) + 1 )); [ "$lines" -lt "$n" ] && n=$(( lines / 60 + 1 ))
      ;;
    *) n="" ;;
  esac
  echo "${n:-1}"
}

total=0
for f in "${files[@]}"; do total=$(( total + $(count_pages "$f") )); done
if [ -n "$pages" ]; then total="$pages"; fi
total=$(( total * copies ))

media="A4"; for ((i=0;i<${#lp_args[@]};i++)); do
  if [ "${lp_args[$i]}" = "-o" ] && [[ "${lp_args[$((i+1))]}" == PageSize=* ]]; then media="${lp_args[$((i+1))]#PageSize=}"; fi
done

if [ "${dry:-0}" = "1" ]; then
  echo "dry run: would print $total page(s) as $kind/$media from: ${files[*]:-stdin} (nothing sent)"
  exit 0
fi
out=$(lp -d "$PRINTER" "${lp_args[@]}" "${files[@]}")
job=$(echo "$out" | grep -oE '[A-Za-z0-9_-]+-[0-9]+' | head -1)
printf '%s,%s,%s,%s,%s,%s,%s\n' \
  "$(date -Iseconds)" "$job" "$PRINTER" "$total" "$media" "$kind" "${files[*]:-stdin}" >> "$LEDGER"
echo "$out  (recorded: $total page(s), $kind, $media)"
